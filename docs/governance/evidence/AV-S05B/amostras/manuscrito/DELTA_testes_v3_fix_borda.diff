+    "coleta/fotos", "referencias/ref.txt",
+])
+def test_sanitizador_mascara_caminho_relativo(caminho):
+    s = br.sanitizar_corpo_erro("open " + caminho + ": no such file")
+    assert s == "open [CAMINHO_OMITIDO]: no such file", s
