+                            r"(?:x[-_]?)?api[-_]?key|"
+                            r"(?:access[-_]?|refresh[-_]?|auth[-_]?)?token|"
+                            r"(?:set[-_]?)?cookie)\b")
 _RES_TEXTO = [
     # data URI de imagem
     (re.compile(r"(?i)data:[\w/+.-]+;base64,[A-Za-z0-9+/=]*"), _MASCARA_BASE64),
