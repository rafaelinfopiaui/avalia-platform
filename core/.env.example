# Core API — configuração de exemplo. NUNCA commitar .env real com credenciais.
ENV=development
DATABASE_URL=postgresql+psycopg2://localhost:5432/avalia_dev
JWT_SECRET=troque-este-valor-em-um-gerador-seguro-antes-de-qualquer-uso-real
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=30
JWT_REFRESH_MINUTES=1440
AI_ENGINE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173
# IMPORTANTE: não usar domínio .local (nem test/invalid/onion/arpa/localhost) — o
# schema de login usa pydantic.EmailStr, que rejeita esses domínios "special-use"
# da IANA com HTTP 422 antes de checar a senha. Use um domínio válido (ex.: .example).
SEED_PROFESSOR_EMAIL=professor.demo@avalia-platform.example
SEED_PROFESSOR_PASSWORD=DemoAvalIA123!
