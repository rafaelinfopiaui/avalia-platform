# Modo de execução: real (chama Ollama) ou simulated (saída determinística para teste/contingência)
AI_ENGINE_MODE=real

# Nome do modelo no Ollama
AI_MODEL_NAME=qwen2.5:7b-instruct-q4_K_M

# URL base do serviço Ollama
OLLAMA_URL=http://localhost:11434

# Servidor FastAPI
HOST=0.0.0.0
PORT=8001

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Caminho relativo ou absoluto do schema JSON de saída
SCHEMA_PATH=../docs/contracts/ai-engine-output.schema.json
